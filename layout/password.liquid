<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {% style %}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      :root {
        --color-dark: {{ settings.color_dark }};
        --color-dark-rgb: {{ settings.color_dark | color_extract: 'red' }}, {{ settings.color_dark | color_extract: 'green' }}, {{ settings.color_dark | color_extract: 'blue' }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-rgb: {{ settings.color_accent | color_extract: 'red' }}, {{ settings.color_accent | color_extract: 'green' }}, {{ settings.color_accent | color_extract: 'blue' }};
        --color-accent-hover: {{ settings.color_accent_hover }};
        --color-bg: {{ settings.color_dark }};
        --color-surface: {{ settings.color_surface }};
        --color-text: #fff;
        --color-sale: {{ settings.color_sale }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
        --font-body-weight-bold: 700;
        --heading-scale: 1;
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.radius }}px;
        --radius-btn: {{ settings.button_radius }}px;
        --logo-width: {{ settings.logo_width }}px;
      }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
