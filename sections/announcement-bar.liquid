{%- if section.blocks.size > 0 -%}
<div class="announcement scheme-{{ section.settings.scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width announcement__inner">
    <announcement-rotator class="announcement__track" data-speed="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        <p class="announcement__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }} {% render 'icon', icon: 'arrow-right' %}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </announcement-rotator>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color",
      "options": [
        { "value": "accent", "label": "Green" },
        { "value": "dark", "label": "Black" },
        { "value": "light", "label": "White" }
      ],
      "default": "accent"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Rotate every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Free shipping on orders over $49" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [ { "type": "announcement" } ] }
  ]
}
{% endschema %}
