<section class="section bundles bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="section-head__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}" class="link-arrow">{{ section.settings.link_label | escape }} {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    <div class="bundles__grid scroller" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign title = block.settings.title
          if title == blank and p != blank
            assign title = p.title
          endif
          if title == blank
            assign title = 'Pet care bundle'
          endif
        -%}
        <article class="bundle-card" {{ block.shopify_attributes }}>
          <div class="bundle-card__top">
            {%- if block.settings.label != blank -%}<span class="bundle-card__label">{{ block.settings.label | escape }}</span>{%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="badge badge--sale">{{ block.settings.badge | escape }}</span>
            {%- elsif p != blank -%}
              {%- render 'product-savings', product: p, style: 'percent' -%}
            {%- endif -%}
          </div>
          <a class="bundle-card__media" href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}" tabindex="-1">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 80vw' }}
            {%- elsif p.featured_media != blank -%}
              {{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 80vw' }}
            {%- else -%}
              {%- capture ph -%}product-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
              {{ ph | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </a>
          <div class="bundle-card__body">
            <h3 class="bundle-card__title">{{ title | escape }}</h3>
            {%- if block.settings.includes != blank -%}<p class="bundle-card__includes">{{ block.settings.includes }}</p>{%- endif -%}
            {%- if p != blank and section.settings.show_price -%}
              {%- render 'price', product: p, use_variant: false -%}
            {%- endif -%}
            <div class="bundle-card__actions">
              {%- if p != blank -%}
                <a href="{{ p.url }}" class="link-underline">{{ 'general.see_details' | t }}</a>
                {%- assign v = p.selected_or_first_available_variant -%}
                {%- form 'product', p, class: 'js-add-form' -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button type="submit" name="add" class="button button--small"{% unless v.available %} disabled{% endunless %}>
                    {%- if v.available -%}{{ 'general.add_to_cart' | t }}{%- else -%}{{ 'general.sold_out' | t }}{%- endif -%}
                  </button>
                {%- endform -%}
              {%- else -%}
                <span class="link-underline">{{ 'general.see_details' | t }}</span>
                <span class="button button--small">{{ 'general.add_to_cart' | t }}</span>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle grid",
  "class": "section-bundles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle & save" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Choose your pet care bundle" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Hand-picked combos that work better together — and cost less." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all bundles" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "surface", "label": "Soft gray" },
        { "value": "dark", "label": "Black" }
      ],
      "default": "white"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "product", "id": "product", "label": "Bundle product", "info": "Create the bundle as a product (e.g. with Shopify Bundles app) and select it here." },
        { "type": "text", "id": "label", "label": "Category label", "default": "Cat care" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the product title." },
        { "type": "inline_richtext", "id": "includes", "label": "What's included", "default": "Litter box + Fountain" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. Save 39%. Leave empty to calculate from compare-at price." },
        { "type": "image_picker", "id": "image", "label": "Custom image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle grid",
      "blocks": [
        { "type": "bundle", "settings": { "label": "Hands-free", "title": "The Complete Hands-Free Home", "includes": "Litter box + Fountain + Feeder", "badge": "Save 39%" } },
        { "type": "bundle", "settings": { "label": "Odor control", "title": "Zero Odor Combo", "includes": "Litter box + Air purifier", "badge": "Save 39%" } },
        { "type": "bundle", "settings": { "label": "Hydration", "title": "Fresh Water Set", "includes": "Litter box + Fountain", "badge": "Save 34%" } },
        { "type": "bundle", "settings": { "label": "Starter", "title": "The Fresh Set", "includes": "Fountain + Filters", "badge": "Save 39%" } }
      ]
    }
  ]
}
{% endschema %}
