<div class="page-width main-content">
  <div class="form-card" style="max-width:640px">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ section.settings.success | escape }}</p>
      {%- elsif form.errors -%}
        <p class="form-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field"><label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
      <div class="field"><label for="ContactEmail">{{ 'customer.email' | t }} *</label><input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></div>
      <div class="field"><label for="ContactPhone">Phone</label><input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="field"><label for="ContactBody">Message</label><textarea id="ContactBody" name="contact[body]">{{ form.body }}</textarea></div>
      <button type="submit" class="button">{{ 'customer.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks! We'll get back to you within 24 hours." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
