<section class="section faq bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width faq__inner">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--dark">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq-item__icon">{% render 'icon', icon: 'plus' %}</span>
          </summary>
          <div class="faq-item__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Everything about Petone" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Can't find what you're looking for? Our pet parent support team is happy to help.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data (SEO)", "default": true },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "surface", "label": "Soft gray" },
        { "value": "dark", "label": "Black" }
      ],
      "default": "white"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is Petone?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Petone is a smart pet care brand making self-cleaning litter boxes, fountains, feeders and more.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What is Petone?", "answer": "<p>Petone is a smart pet care brand creating connected products — self-cleaning litter boxes, water fountains, feeders and grooming tools — that make daily pet care easier and more hygienic.</p>" } },
        { "type": "question", "settings": { "question": "Which pets are Petone products designed for?", "answer": "<p>Most of our products are designed for cats and small to medium dogs. Each product page lists the recommended pet size and weight.</p>" } },
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders are usually processed within 1–2 business days. Delivery times depend on your location and are shown at checkout.</p>" } },
        { "type": "question", "settings": { "question": "What warranty do you offer?", "answer": "<p>All Petone devices include a manufacturer warranty. Bundles and selected products include an extended warranty.</p>" } },
        { "type": "question", "settings": { "question": "Can I return a product?", "answer": "<p>Yes. You can try Petone risk-free for 30 days. If you're not happy, contact us to start a return.</p>" } }
      ]
    }
  ]
}
{% endschema %}
