<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="logo footer__logo">{% render 'logo', variant: 'dark' %}</a>
        {%- if section.settings.about != blank -%}<div class="footer__about rte">{{ section.settings.about }}</div>{%- endif -%}
        {% render 'social-icons' %}
      </div>

      <div class="footer__cols" style="--cols: {{ section.blocks.size | at_least: 1 }};">
        {%- for block in section.blocks -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<h3 class="footer__heading">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- case block.type -%}
              {%- when 'menu' -%}
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                <div class="rte footer__text">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.newsletter -%}
        <div class="footer__newsletter">
          <h3 class="footer__heading">{{ section.settings.newsletter_heading | escape }}</h3>
          {%- if section.settings.newsletter_text != blank -%}<p class="footer__text">{{ section.settings.newsletter_text | escape }}</p>{%- endif -%}
          {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-success">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              <div class="newsletter-form__field">
                <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}">
                <button type="submit" class="button button--small">{{ 'newsletter.subscribe' | t }}</button>
              </div>
              {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      {%- if localization.available_countries.size > 1 and section.settings.show_country -%}
        {%- form 'localization', class: 'footer__localization' -%}
          <label class="visually-hidden" for="FooterCountry">Country</label>
          <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
            {%- for c in localization.available_countries -%}
              <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright }}</p>
      {%- if section.settings.show_payment -%}
        <ul class="footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    { "type": "richtext", "id": "about", "label": "About text", "default": "<p>Smart pet tech for modern homes. Less chores, more cuddles.</p>" },
    { "type": "checkbox", "id": "newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Petone pack" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Get exclusive deals, new launches and pet care tips." },
    { "type": "checkbox", "id": "show_country", "label": "Show country / currency selector", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Information" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Customer service" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mon – Fri, 9am – 6pm</p>" }
      ]
    }
  ]
}
{% endschema %}
