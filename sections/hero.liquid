{%- liquid
  assign s = section.settings
-%}
<section class="hero hero--{{ s.height }} hero--align-{{ s.content_position }}" style="--overlay: {{ s.overlay | divided_by: 100.0 }};">
  <div class="hero__media">
    {%- if s.video != blank -%}
      {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'hero__video', image_size: '1920x' }}
    {%- elsif s.image != blank -%}
      {%- assign desktop_class = 'hero__img' -%}
      {%- if s.image_mobile != blank -%}
        {%- assign desktop_class = 'hero__img hero__img--desktop' -%}
        {{ s.image_mobile | image_url: width: 1100 | image_tag: class: 'hero__img hero__img--mobile', loading: 'eager', fetchpriority: 'high', widths: '550, 750, 1100', sizes: '100vw' }}
      {%- endif -%}
      {{ s.image | image_url: width: 2800 | image_tag: class: desktop_class, loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400, 2800', sizes: '100vw' }}
    {%- else -%}
      <div class="hero__placeholder">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}</div>
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    <div class="hero__text">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', icon: 'paw' %} {{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="hero__heading h-display">{{ s.heading }}</h1>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="hero__sub">{{ s.subheading }}</p>
      {%- endif -%}
      {%- if s.button_label != blank or s.button2_label != blank -%}
        <div class="button-row">
          {%- if s.button_label != blank -%}
            <a href="{{ s.button_link }}" class="button button--large">{{ s.button_label | escape }} {% render 'icon', icon: 'arrow-right' %}</a>
          {%- endif -%}
          {%- if s.button2_label != blank -%}
            <a href="{{ s.button2_link }}" class="button button--large button--ghost">{{ s.button2_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if s.promo_show -%}
      <div class="hero__promo">
        {%- if s.promo_label != blank -%}<span class="badge badge--accent">{{ s.promo_label | escape }}</span>{%- endif -%}
        {%- if s.promo_heading != blank -%}<p class="hero__promo-heading">{{ s.promo_heading }}</p>{%- endif -%}
        {%- if s.promo_amount != blank -%}<p class="hero__promo-amount">{{ s.promo_amount | escape }}</p>{%- endif -%}
        {%- if s.promo_button_label != blank -%}
          <a href="{{ s.promo_button_link }}" class="hero__promo-link">{{ s.promo_button_label | escape }} {% render 'icon', icon: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2800 x 1400px recommended" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. 1100 x 1400px recommended" },
    { "type": "video", "id": "video", "label": "Background video", "info": "Optional. Replaces the image when set." },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "overlay", "label": "Image darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Smart pet tech for modern homes" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Smarter care. <em>Happier pets.</em>" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "Self-cleaning litter boxes, smart fountains and feeders that take care of the daily chores — so you can enjoy more time with your pet." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Why Petone" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "header", "content": "Promo card" },
    { "type": "checkbox", "id": "promo_show", "label": "Show promo card", "default": true },
    { "type": "text", "id": "promo_label", "label": "Label", "default": "Fall Sale" },
    { "type": "inline_richtext", "id": "promo_heading", "label": "Heading", "default": "Settle into fall. Keep it fresh." },
    { "type": "text", "id": "promo_amount", "label": "Highlight", "default": "Save up to $400" },
    { "type": "text", "id": "promo_button_label", "label": "Link label", "default": "Shop bundles" },
    { "type": "url", "id": "promo_button_link", "label": "Link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
