<article class="page-width article">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ blog.url }}">{{ blog.title | escape }}</a></nav>
  <h1 class="h1">{{ article.title | escape }}</h1>
  <div class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }} · {{ article.author }}</div>
  {%- if article.image -%}
    <div class="article__hero">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 820px, 100vw' }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p style="margin-top:48px"><a href="{{ blog.url }}" class="button button--outline">← {{ blog.title | escape }}</a></p>
</article>
{% schema %}
{ "name": "Article" }
{% endschema %}
