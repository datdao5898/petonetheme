<div class="page-header page-header--dark">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ collection.title | escape }}</nav>
    <h1 class="h1">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
  </div>
</div>
<div class="page-width main-content" style="padding-top:32px">
  {%- paginate collection.products by section.settings.per_page -%}
    <div class="collection-toolbar">
      <span class="collection-count">{{ collection.products_count }} products</span>
      {%- if section.settings.show_sort -%}
        <form method="get">
          <label class="visually-hidden" for="SortBy">Sort by</label>
          <select id="SortBy" name="sort_by" onchange="this.form.submit()">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product, show_price: true %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="center" style="padding:60px 0">{{ 'general.no_products' | t }}</p>
    {%- endif -%}
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>
{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}
