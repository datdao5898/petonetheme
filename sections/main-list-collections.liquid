<div class="page-width main-content">
  <div class="page-header"><h1 class="h1">{{ page_title | escape }}</h1></div>
  <div class="collection-tiles">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="collection-tile">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span class="collection-tile__title">{{ collection.title | escape }} {% render 'icon', icon: 'arrow-right' %}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Collections list" }
{% endschema %}
