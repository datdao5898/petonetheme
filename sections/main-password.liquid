<div class="page-width not-found" style="padding:96px 20px">
  <a href="{{ routes.root_url }}" class="logo" style="display:inline-block;margin-bottom:32px">{% render 'logo', variant: 'dark' %}</a>
  <h1 class="h1">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p style="opacity:.75">{{ shop.password_message }}</p>{%- endif -%}
  <div style="max-width:440px;margin:32px auto 0">
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'newsletter.success' | t }}</p>{%- else -%}
        <div class="newsletter-form__field"><input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}"><button type="submit" class="button button--small">{{ 'newsletter.subscribe' | t }}</button></div>
      {%- endif -%}
    {%- endform -%}
  </div>
  <details style="margin-top:40px">
    <summary style="cursor:pointer;opacity:.7">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', style: 'max-width:440px;margin:16px auto 0' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="newsletter-form__field"><input type="password" name="password" autocomplete="current-password" placeholder="{{ 'customer.password' | t }}" aria-label="{{ 'customer.password' | t }}"><button type="submit" class="button button--small">{{ 'password.submit' | t }}</button></div>
    {%- endform -%}
  </details>
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Something smart is coming" }]
}
{% endschema %}
