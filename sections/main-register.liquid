<div class="page-width main-content" style="padding-top:56px">
  <div class="form-card">
    <h1 class="h2">{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="RegEmail">{{ 'customer.email' | t }}</label><input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="RegPass">{{ 'customer.password' | t }}</label><input id="RegPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <button type="submit" class="button">{{ 'customer.register' | t }}</button>
    {%- endform -%}
    <div class="form-card__links"><a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a></div>
  </div>
</div>
{% schema %}
{ "name": "Register" }
{% endschema %}
