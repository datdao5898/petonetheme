<div class="page-width main-content" style="padding-top:56px">
  <div class="form-card">
    <h1 class="h2">{{ 'customer.reset_password' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="ResetPass">{{ 'customer.password' | t }}</label><input id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPass2">Confirm password</label><input id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="button">{{ 'customer.reset_password' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Reset password" }
{% endschema %}
