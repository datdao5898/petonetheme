<section class="section trust-bar bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <ul class="trust-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-item" {{ block.shopify_attributes }}>
          <span class="trust-item__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {% render 'icon', icon: block.settings.icon %}
            {%- endif -%}
          </span>
          <span>
            <strong class="trust-item__title">{{ block.settings.title | escape }}</strong>
            {%- if block.settings.text != blank -%}<span class="trust-item__text">{{ block.settings.text | escape }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "class": "section-trust",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "surface", "label": "Soft gray" },
        { "value": "dark", "label": "Black" },
        { "value": "accent", "label": "Green" }
      ],
      "default": "white"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "trial", "label": "Trial" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "payment", "label": "Payment" },
            { "value": "support", "label": "Support" },
            { "value": "paw", "label": "Paw" }
          ],
          "default": "shipping"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over $49" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "item", "settings": { "icon": "trial", "title": "30-day trial", "text": "Risk-free returns" } },
        { "type": "item", "settings": { "icon": "shipping", "title": "Free shipping", "text": "On orders over $49" } },
        { "type": "item", "settings": { "icon": "warranty", "title": "Up to 2-year warranty", "text": "Peace of mind included" } },
        { "type": "item", "settings": { "icon": "payment", "title": "Pay later", "text": "Flexible installments" } }
      ]
    }
  ]
}
{% endschema %}
