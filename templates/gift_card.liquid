{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gift card — {{ shop.name }}</title>
  {{ content_for_header }}
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: {{ settings.color_dark }}; color: #fff; font-family: system-ui, sans-serif; text-align: center; padding: 24px; }
    .card { max-width: 440px; width: 100%; padding: 40px 28px; border-radius: 24px; background: #131619; }
    .amount { font-size: 2.6rem; font-weight: 800; color: {{ settings.color_accent }}; margin: 12px 0; }
    .code { font-family: monospace; font-size: 1.3rem; letter-spacing: .1em; padding: 14px; border: 1px dashed rgba(255,255,255,.3); border-radius: 12px; margin: 20px 0; }
    a.btn { display: inline-block; padding: 14px 28px; border-radius: 40px; background: {{ settings.color_accent }}; color: {{ settings.color_dark }}; font-weight: 700; text-decoration: none; }
    img { margin: 0 auto 20px; width: 140px; }
  </style>
</head>
<body>
  <div class="card">
    <img src="{{ 'logo-green.png' | asset_url }}" alt="{{ shop.name | escape }}" width="140" height="33">
    <div>Gift card</div>
    <div class="amount">{{ gift_card.balance | money }}</div>
    {%- if gift_card.expired or gift_card.enabled == false -%}<p>This gift card is no longer valid.</p>{%- endif -%}
    <div class="code">{{ gift_card.code | format_code }}</div>
    {%- if gift_card.expires_on -%}<p style="opacity:.6">Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{%- endif -%}
    <a class="btn" href="{{ shop.url }}">{{ 'general.shop_now' | t }}</a>
  </div>
</body>
</html>
